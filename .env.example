# ChatCloser 2.0 — configuration
#
# Copy this file to .env and fill in the values. Everything here is read at
# startup; the app never writes to .env.
#
#   Node:    copy .env.example .env
#   Windows: Copy-Item .env.example .env
#
# The desktop application does not need this file: it generates its own
# secrets on first run and keeps them in its user-data folder.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# 64 hex characters (32 bytes). Encrypts AI provider keys, payment secrets
# and WhatsApp credentials stored in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# At least 32 characters. Signs the admin session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first owner account, created on first run only. If ADMIN_PASSWORD is
# omitted, a strong password is generated, printed once and written to
# first-run-credentials.txt in the data folder.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------

BUSINESS_NAME=Your Company Name
BUSINESS_ID=1

# One of: retail, ecommerce, restaurant, construction, realestate, travel,
# hospitality, professional, education, clinic, salon, repair, manufacturing,
# agriculture, custom. Applied once on first run; change it later in Settings.
INDUSTRY_TEMPLATE=retail

# The panel listens on loopback by default. Set 0.0.0.0 to accept connections
# from other machines, and put it behind HTTPS if you do.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001

# Internal control API for the WhatsApp process. Never expose this.
BOT_CONTROL_HOST=127.0.0.1
BOT_CONTROL_PORT=3002

# Mark cookies Secure. Enable only when the panel is served over HTTPS,
# otherwise browsers drop the session cookie and sign-in fails.
COOKIE_SECURE=0

NODE_ENV=production

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------

WHATSAPP_ENABLED=true

# Messages per chat per minute, and per workspace per minute.
RATE_LIMIT_PER_CHAT_PER_MIN=6
RATE_LIMIT_GLOBAL_PER_MIN=30

# Send a follow-up "are you still there?" after this many idle hours (0 = off).
NUDGE_AFTER_HOURS=24

# ---------------------------------------------------------------------------
# Payments (configure the rest from the admin panel, where secrets are
# encrypted in the database)
# ---------------------------------------------------------------------------

# Where the customer lands after paying, and after cancelling.
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Stripe webhook path is POST /webhooks/stripe on the control API
# (http://127.0.0.1:3002 by default, or your public origin if you proxy it).

# eSewa and Khalti are configured in the panel: Integrations -> Payments.
# Use each provider's sandbox credentials first.

# ---------------------------------------------------------------------------
# Security hardening
# ---------------------------------------------------------------------------

# Refuse to start with placeholder or missing secrets. On by default outside
# Electron. Only turn this off for local experiments.
CHATCLOSER_STRICT_SECRETS=1
CHATCLOSER_ALLOW_INSECURE_SECRETS=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where the database, WhatsApp session, backups and logs live.
# Default: ./data next to package.json
# CHATCLOSER_DATA_DIR=
# CHATCLOSER_DB_PATH=
